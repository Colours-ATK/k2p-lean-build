@@ -2520,6 +2520,11 @@
 	EDCA_PARM APEdcaParm[WMM_NUM];	/* EDCA parameters of the current associated AP */
 	QBSS_LOAD_PARM APQbssLoad;	/* QBSS load of the current associated AP */
 	UCHAR AckPolicy[WMM_NUM_OF_AC];	/* ACK policy of the specified AC. see ACK_xxx */
+	/* Override for the apcli uplink's BE (AC0) EDCA Cwmin.
+	 * 0..15 = force that Cwmin; 255 (default) = keep the value
+	 * delivered by the upstream AP.
+	 */
+	UCHAR ApCliEdcaCwmin;
 	/* a bitmap of BOOLEAN flags. each bit represent an operation status of a particular */
