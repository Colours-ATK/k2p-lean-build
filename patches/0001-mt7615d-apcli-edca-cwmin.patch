diff -urN orig/embedded/ap/apcli_assoc.c new/embedded/ap/apcli_assoc.c
--- orig/embedded/ap/apcli_assoc.c	2026-11-01 13:02:06.295596289 +0800
+++ new/embedded/ap/apcli_assoc.c	2026-11-01 13:02:39.420596663 +0800
@@ -1589,6 +1589,17 @@
 	pApCliEntry->MlmeAux.BssType = BSS_INFRA;
 	pApCliEntry->MlmeAux.CapabilityInfo = CapabilityInfo & SUPPORTED_CAPABILITY_INFO;
 	NdisMoveMemory(&pApCliEntry->MlmeAux.APEdcaParm, pEdcaParm, sizeof(EDCA_PARM));
+	/* Optional local override of the uplink's BE (AC0) Cwmin.
+	 * The upstream AP's EDCA parameters normally decide how
+	 * aggressively our uplink retries; on a same-band relay that
+	 * directly affects airtime sharing with our own AP side.
+	 */
+	if (pAd->CommonCfg.ApCliEdcaCwmin <= 15) {
+		pApCliEntry->MlmeAux.APEdcaParm.Cwmin[0] = pAd->CommonCfg.ApCliEdcaCwmin;
+		MTWF_LOG(DBG_CAT_CLIENT, CATCLIENT_APCLI, DBG_LVL_INFO,
+				("apcli uplink EDCA BE Cwmin overridden to %d\n\",
+				pAd->CommonCfg.ApCliEdcaCwmin));
+	}
 	/* filter out un-supported rates */
 	pApCliEntry->MlmeAux.SupRateLen = SupRateLen;
 	NdisMoveMemory(pApCliEntry->MlmeAux.SupRate, SupRate, SupRateLen);
diff -urN orig/embedded/common/cmm_profile.c new/embedded/common/cmm_profile.c
--- orig/embedded/common/cmm_profile.c	2026-11-01 13:02:06.297596289 +0800
+++ new/embedded/common/cmm_profile.c	2026-11-01 13:02:39.421596663 +0800
@@ -5773,6 +5773,26 @@
 
 #endif /* MAC_REPEATER_SUPPORT */
 		}
+
+		/* Optional EDCA override for the apcli (STA) uplink.
+		 * ApCliEdcaCwmin=0..15 forces the BE (AC0) Cwmin of the
+		 * apcli's EDCA parameters; 255 (default) keeps the value
+		 * provided by the upstream AP.
+		 */
+		{
+			UCHAR cwmin = 255;
+
+			if (RTMPGetKeyParameter("ApCliEdcaCwmin", tmpbuf, 10, pBuffer, FALSE)) {
+				INT val = os_str_tol(tmpbuf, 0, 10);
+
+				if (val >= 0 && val <= 15)
+					cwmin = (UCHAR)val;
+			}
+
+			pAd->CommonCfg.ApCliEdcaCwmin = cwmin;
+			MTWF_LOG(DBG_CAT_CFG, DBG_SUBCAT_ALL, DBG_LVL_INFO,
+					("ApCliEdcaCwmin=%d (255 = keep upstream EDCA)\n\", cwmin));
+		}
 #endif /* CONFIG_AP_SUPPORT */
 
 		if (RTMPGetKeyParameter("SE_OFF", tmpbuf, 25, pBuffer, TRUE)) {
